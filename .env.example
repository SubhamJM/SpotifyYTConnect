# ==========================================
# Spotify Configuration
# ==========================================
# Get these from Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID="your_spotify_client_id_here"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret_here"

# Required if editing Spotify playlists or accessing private playlists.
# Generate via: python setup_spotify.py
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token_here"

# ==========================================
# YouTube Music Configuration
# ==========================================
# Paste the entire content of oauth.json as a single string (used in GitHub Actions Secret)
# For local development, having oauth.json in the project root is sufficient.
YTM_OAUTH_JSON=""

# ==========================================
# Sync Playlist Configuration
# ==========================================
# Single playlist pair sync:
SPOTIFY_PLAYLIST_ID="your_spotify_playlist_id_or_link"
YTMUSIC_PLAYLIST_ID="your_ytmusic_playlist_id_or_link"

# Sync Direction:
# - "spotify_to_yt" : Changes from Spotify are added to YouTube Music
# - "yt_to_spotify" : Changes from YouTube Music are added to Spotify
# - "both"          : Bidirectional sync (both playlists mirror each other)
SYNC_DIRECTION="both"

# (Optional) Advanced: Multiple playlist pairs sync in JSON format
# If SYNC_PAIRS is defined, it takes precedence over the single playlist IDs above.
# SYNC_PAIRS='[{"spotify_id": "SP_ID_1", "yt_id": "YT_ID_1", "direction": "both"}]'
